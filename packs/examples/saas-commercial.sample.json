      },
      {
        "canonical_name": "Beacon Logistics LLC",
        "domains": [
          "beacon-logistics.example"
        ],
        "emails": [
          "vendor-desk@beacon-logistics.example"
        ],
        "patterns": [
          "\\bBeacon\\s+Logistics\\b"
        ],
        "aliases": [
          "Beacon"
        ],
        "metadata": {
          "segment": "midmarket"
        }
      }
    ]
  },
  "topics": {
    "generic_suffix_patterns": [
      "\\s*-\\s*renewal$",
      "\\s*-\\s*order\\s+form$",
      "\\s*\\[confidential\\]$"
    ],
    "entries": [
      {
        "canonical_name": "FY26 Enterprise Renewal",
        "patterns": [
          "\\bFY26\\s+Enterprise\\s+Renewal\\b",
          "\\bNS-REN-2026\\b"
        ],
        "aliases": [
          "2026 Renewal"
        ],
        "metadata": {
          "deal_motion": "renewal"
        }
      },
      {
        "canonical_name": "Security & DPA Review",
        "patterns": [
          "\\bVSAQ\\b",
          "\\bHECVAT\\b",
          "\\bSecurity\\s+Questionnaire\\b",
          "\\bDPA\\s+Redline\\b"
        ],
        "aliases": [
          "InfoSec Review"
        ],
        "metadata": {
          "deal_motion": "infosec"
        }
      },
      {
        "canonical_name": "EU Expansion Rollout",
        "patterns": [
          "\\bEU\\s+Expansion\\b",
          "\\bEMEA\\s+Seat\\s+Rollout\\b"
        ],
        "aliases": [
          "EU Rollout"
        ],
        "metadata": {
          "deal_motion": "expansion"
        }
      }
    ]
  },
  "intents": [
    {
      "intent": "renewal",
      "priority": 100,
      "patterns": [
        "\\bsubscription\\s+renewal\\b",
        "\\bauto-?renew\\b",
        "\\brenewal\\s+quote\\b",
        "\\bopt-?out\\s+notice\\b"
      ]
    },
    {
      "intent": "order_form_contract",
      "priority": 95,
      "patterns": [
        "\\border\\s+form\\b",
        "\\bMSA\\b",
        "\\bSOW\\b",
        "\\bredline\\b",
        "\\bDocuSign\\b"
      ]
    },
    {
      "intent": "security_compliance",
      "priority": 85,
      "patterns": [
        "\\bSOC\\s*2\\b",
        "\\bsecurity\\s+questionnaire\\b",
        "\\bpenetration\\s+test\\b",
        "\\bDPA\\b"
      ]
    },
    {
      "intent": "pricing_expansion",
      "priority": 80,
      "patterns": [
        "\\bseat\\s+expansion\\b",
        "\\bvolume\\s+discount\\b",
        "\\bARR\\b",
        "\\bACV\\b",
        "\\bco-?term\\b"
      ]
    },
    {
      "intent": "invoicing_po",
      "priority": 75,
      "patterns": [
        "\\bnet\\s*30\\b",
        "\\bnet\\s*45\\b",
        "\\bW-?9\\b",
        "\\bACH\\s+remittance\\b",
        "\\binvoice\\s*#\\b"
      ]
    }
  ],
  "amounts": {
    "exclude_subject_patterns": [
      "\\bproduct\\s+changelog\\b",
      "\\bstatus\\s+page\\b",
      "\\bwebinar\\b"
    ],
    "type_rules": [
      {
        "amount_type": "contract_acv",
        "confidence": "high",
        "priority": 100,
        "patterns": [
          "\\bACV\\b",
          "\\bannual\\s+contract\\s+value\\b",
          "\\border\\s+form\\s+total\\b"
        ]
      },
      {
        "amount_type": "renewal_quote",
        "confidence": "high",
        "priority": 90,
        "patterns": [
          "\\brenewal\\s+quote\\b",
          "\\bco-?term\\s+total\\b"
        ]
      },
      {
        "amount_type": "invoice",
        "confidence": "high",
        "priority": 85,
        "patterns": [
          "\\binvoice\\s*#",
          "\\bamount\\s+due\\b"
        ]
      },
      {
        "amount_type": "expansion_estimate",
        "confidence": "medium",
        "priority": 50,
        "patterns": [
          "\\bexpansion\\s+estimate\\b",
          "\\bseat\\s+upgrade\\b"
        ]
      }
    ],
    "currency_aliases": {
      "US$": "USD",
      "$": "USD",
      "€": "EUR",
      "£": "GBP",
      "CAD$": "CAD",
      "AUD$": "AUD"
    }
  }
}
