{
  "schema_version": "domain-pack.v1",
  "pack_id": "saas-commercial-example",
  "name": "B2B SaaS Commercial, Renewals & Cloud Procurement (Sample)",
  "version": "1.0",
  "description": "100% fictional reference domain pack for enterprise SaaS sales, annual/multi-year renewals, security/compliance reviews, and subscription order forms.",
  "identity": {
    "self_emails": [
      "deals@northstar-cloud.example",
      "renewals@northstar-cloud.example"
    ],
    "self_name_tokens": [
      "Northstar Deal Desk",
      "Northstar Cloud Inc"
    ],
    "internal_domains": [
      "northstar-cloud.example"
    ],
    "system_senders": [
      "billing-noreply@northstar-cloud.example",
      "docusign-bot@northstar-cloud.example"
    ],
    "system_domains": [
      "billing.northstar-cloud.example"
    ],
    "system_subject_prefixes": [
      "[Billing-Auto]",
      "Completed: Please DocuSign:",
      "Auto-Receipt:"
    ],
    "system_body_markers": [
      "automatically generated billing receipt",
      "Do not reply to this automated notification"
    ],
    "noise_attachment_prefixes": [
      "northstar_brand",
      "social_icon",
      "footer_logo"
    ]
  },
  "entity_rules": {
    "default_category": "General",
    "exclude_code_tokens": [
      "SOC-2",
      "ISO-27001",
      "HTTP-404",
      "TLS-1",
      "RFC-5322",
      "SLA-99",
      "FY-2026"
    ],
    "code_patterns": [
      {
        "name": "ns_enterprise_plan",
        "pattern": "\\b(NS-ENT-\\d{2,4})(?:-[A-Z0-9]{1,8})*\\b",
        "category": "EnterprisePlan",
        "sub_group": "$1",
        "priority": 100,
        "exclude_if_matches": [],
        "extra_terms": [
          "enterprise subscription",
          "annual seat license"
        ]
      },
      {
        "name": "ns_team_plan",
        "pattern": "\\b(NS-PRO-\\d{2,4})(?:-[A-Z0-9]{1,8})*\\b",
        "category": "TeamPlan",
        "sub_group": "$1",
        "priority": 90,
        "exclude_if_matches": [],
        "extra_terms": [
          "team subscription"
        ]
      },
      {
        "name": "ns_addon_lookaround",
        "pattern": "(?<![A-Za-z0-9])NS-ADD-[A-Z0-9-]{2,16}(?![A-Za-z0-9])",
        "category": "AddOn",
        "series_regex": "^(NS-ADD-[A-Z]+)",
        "priority": 80,
        "exclude_if_matches": [],
        "extra_terms": [
          "platform add-on"
        ]
      },
      {
        "name": "ns_support_tier",
        "pattern": "\\b(NS-SUP-(?:PREM|GOLD|24X7))(?:-[A-Z0-9]+)?\\b",
        "category": "SupportTier",
        "sub_group": "$1",
        "priority": 75,
        "exclude_if_matches": [],
        "extra_terms": [
          "sla support tier"
        ]
      },
      {
        "name": "ns_onboarding_services",
        "pattern": "\\b(NS-SVC-\\d{2,4})(?:-[A-Z0-9]+)?\\b",
        "category": "ProfessionalServices",
        "sub_group": "$1",
        "priority": 70,
        "exclude_if_matches": [],
        "extra_terms": [
          "onboarding package",
          "implementation sow"
        ]
      }
    ],
    "category_fallbacks": [
      {
        "category": "EnterprisePlan",
        "priority": 50,
        "patterns": [
          "\\benterprise\\s+(?:annual|multi-year)\\s+license\\b",
          "\\bSSO\\s*\\+\\s*SCIM\\s+tier\\b"
        ]
      },
      {
        "category": "AddOn",
        "priority": 40,
        "patterns": [
          "\\bdedicated\\s+VPC\\s+add-on\\b",
          "\\baudit\\s+log\\s+retention\\s+pack\\b"
        ]
      },
      {
        "category": "ProfessionalServices",
        "priority": 30,
        "patterns": [
          "\\bimplementation\\s+SOW\\b",
          "\\bmigration\\s+workshop\\b"
        ]
      }
    ]
  },
  "dimensions": [
    {
      "name": "compliance",
      "entity_type": "compliance",
      "entries": [
        {
          "key": "SOC2_Type_II",
          "canonical_name": "SOC 2 Type II Attestation",
          "patterns": [
            "\\bSOC\\s*2\\s*Type\\s*(?:II|2)\\b"
          ],
          "aliases": [
            "SOC2 Type II"
          ],
          "metadata": {
            "framework": "AICPA"
          }
        },
        {
          "key": "ISO_27001",
          "canonical_name": "ISO/IEC 27001 ISMS",
          "patterns": [
            "\\bISO\\s*/?\\s*(?:IEC\\s*)?27001\\b"
          ],
          "aliases": [
            "ISO27001"
          ],
          "metadata": {
            "framework": "ISO"
          }
        },
        {
          "key": "GDPR_DPA",
          "canonical_name": "GDPR Data Processing Addendum",
          "patterns": [
            "\\bGDPR\\b",
            "\\bData\\s+Processing\\s+Addendum\\b",
            "\\bDPA\\b"
          ],
          "aliases": [
            "Standard Contractual Clauses",
            "SCC"
          ],
          "metadata": {
            "region": "EU"
          }
        },
        {
          "key": "HIPAA_BAA",
          "canonical_name": "HIPAA Business Associate Agreement",
          "patterns": [
            "\\bHIPAA\\b",
            "\\bBAA\\b"
          ],
          "aliases": [
            "Healthcare Compliance"
          ],
          "metadata": {
            "sector": "healthcare"
          }
        }
      ]
    },
    {
      "name": "deployment_tier",
      "entity_type": "deployment_tier",
      "entries": [
        {
          "key": "Dedicated_VPC",
          "canonical_name": "Single-Tenant Dedicated VPC",
          "patterns": [
            "\\bdedicated\\s+VPC\\b",
            "\\bsingle-tenant\\b"
          ],
          "aliases": [
            "Private Cloud"
          ],
          "metadata": {
            "isolation": "dedicated"
          }
        },
        {
          "key": "Multi_Tenant_EU",
          "canonical_name": "EU Region Multi-Tenant Cloud",
          "patterns": [
            "\\bEU\\s+(?:data\\s+)?residency\\b",
            "\\bFrankfurt\\s+region\\b"
          ],
          "aliases": [
            "EU Hosted"
          ],
          "metadata": {
            "region": "eu-central"
          }
        },
        {
          "key": "BYOC_Hybrid",
          "canonical_name": "Bring Your Own Cloud Hybrid",
          "patterns": [
            "\\bBYOC\\b",
            "\\bbring\\s+your\\s+own\\s+cloud\\b"
          ],
          "aliases": [
            "Customer Hosted Data Plane"
          ],
          "metadata": {
            "isolation": "hybrid"
          }
        }
      ]
    }
  ],
  "organizations": {
    "exclude_domains": [
      "gmail.com",
      "outlook.com",
      "proton.me",
      "icloud.com"
    ],
    "exclude_names": [
      "unknown",
      "procurement",
      "legal",
      "billing"
    ],
    "domain_to_org": {
      "cascade-fintech.example": "Cascade FinTech Corp",
      "veridian-bio.example": "Veridian BioLabs Inc",
      "harbor-retail.example": "Harbor Retail Group"
    },
    "email_to_org": {
      "vendor-desk@beacon-logistics.example": "Beacon Logistics LLC"
    },
    "entries": [
      {
        "canonical_name": "Cascade FinTech Corp",
        "domains": [
          "cascade-fintech.example"
        ],
        "emails": [],
