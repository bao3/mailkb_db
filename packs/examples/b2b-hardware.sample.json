  "entity_rules": {
    "default_category": "General",
    "exclude_code_tokens": [
      "ISO-9001",
      "ISO-14001",
      "IEC-61000",
      "IEEE-802",
      "UTF-8",
      "RFC-2047",
      "PO-BOX",
      "REV-01",
      "VER-1",
      "WIN-11"
    ],
    "code_patterns": [
      {
        "name": "acme_switch",
        "pattern": "\\b(ACME-SW-\\d{3,4})(?:-[A-Z0-9]{1,8})*\\b",
        "category": "Switch",
        "sub_group": "$1",
        "priority": 100,
        "exclude_if_matches": [
          "\\bACME-SW-0000\\b"
        ],
        "extra_terms": [
          "ethernet switch",
          "din-rail switch"
        ]
      },
      {
        "name": "acme_gateway_lookaround",
        "pattern": "(?<![A-Za-z0-9])ACME-GW-\\d{3,4}[A-Z]?(?:-[A-Z0-9]{1,6})*(?![A-Za-z0-9])",
        "category": "Gateway",
        "series_regex": "^(ACME-GW-\\d{3,4})",
        "priority": 95,
        "exclude_if_matches": [],
        "extra_terms": [
          "protocol gateway",
          "modbus gateway"
        ]
      },
      {
        "name": "acme_router",
        "pattern": "\\b(ACME-RT-\\d{3,4})(?:-[A-Z0-9]{1,6})*\\b",
        "category": "Router",
        "sub_group": "$1",
        "priority": 90,
        "exclude_if_matches": [],
        "extra_terms": [
          "industrial router",
          "cellular vpn"
        ]
      },
      {
        "name": "acme_wireless",
        "pattern": "\\b(ACME-AP-\\d{3,4})(?:-[A-Z0-9]{1,6})*\\b",
        "category": "Wireless",
        "sub_group": "$1",
        "priority": 85,
        "exclude_if_matches": [],
        "extra_terms": [
          "industrial wifi",
          "access point"
        ]
      },
      {
        "name": "acme_edge_compute",
        "pattern": "\\b(ACME-IPC-\\d{3,4})(?:-[A-Z0-9]{1,8})*\\b",
        "category": "EdgeCompute",
        "sub_group": "$1",
        "priority": 80,
        "exclude_if_matches": [],
        "extra_terms": [
          "edge computer",
          "fanless ipc"
        ]
      },
      {
        "name": "acme_io_module",
        "pattern": "\\b(ACME-IO-\\d{3,4})(?:-[A-Z0-9]{1,6})*\\b",
        "category": "IO",
        "sub_group": "$1",
        "priority": 75,
        "exclude_if_matches": [],
        "extra_terms": [
          "remote io",
          "daq module"
        ]
      },
      {
        "name": "acme_sfp_optic",
        "pattern": "\\bACME-SFP-(?:1G|10G|SX|LX|ZX)-[A-Z0-9-]{2,12}\\b",
        "category": "Accessory",
        "sub_group": "ACME-SFP",
        "priority": 70,
        "exclude_if_matches": [],
        "extra_terms": [
          "sfp transceiver",
          "fiber module"
        ]
      },
      {
        "name": "acme_power_supply",
        "pattern": "\\b(ACME-PWR-\\d{2,4})(?:-[A-Z0-9]{1,4})*\\b",
        "category": "Power",
        "sub_group": "$1",
        "priority": 65,
        "exclude_if_matches": [],
        "extra_terms": [
          "din-rail psu",
          "24vdc power"
        ]
      },
      {
        "name": "acme_management_software",
        "pattern": "\\bACME-(?:NMS|CFG)-(?:PRO|ENT|STD)(?:-V\\d+)?\\b",
        "category": "Software",
        "sub_group": "ACME-NMS",
        "priority": 60,
        "exclude_if_matches": [],
        "extra_terms": [
          "network management license"
        ]
      }
    ],
    "category_fallbacks": [
      {
        "category": "Switch",
        "priority": 50,
        "patterns": [
          "\\b(?:L2|L3)\\s+managed\\s+switch\\b",
          "\\bPoE\\+?\\s+industrial\\s+switch\\b"
        ]
      },
      {
        "category": "Gateway",
        "priority": 45,
        "patterns": [
          "\\bModbus\\s+(?:TCP|RTU)\\s+gateway\\b",
          "\\bOPC\\s*UA\\s+gateway\\b"
        ]
      },
      {
        "category": "Power",
        "priority": 40,
        "patterns": [
          "\\bDIN-rail\\s+power\\s+supply\\b",
          "\\bredundant\\s+PSU\\b"
        ]
      },
      {
        "category": "Accessory",
        "priority": 30,
        "patterns": [
          "\\bSFP\\+?\\s+transceiver\\b",
          "\\bDIN-rail\\s+mounting\\s+kit\\b"
        ]
      }
    ]
  },
